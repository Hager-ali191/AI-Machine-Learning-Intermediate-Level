// Pharos Logistics - normalized physical model (paste into https://dbdiagram.io/d)
Project pharos_logistics {
  database_type: 'PostgreSQL'
  Note: 'Normalized (3NF) relational model for the Pharos legacy orders data'
}

Table customers {
  customer_id    serial       [pk]
  customer_name  varchar(100) [not null]
  street_address varchar(150) [not null]
  city           varchar(50)  [not null]
}

Table suppliers {
  supplier_id      serial       [pk]
  supplier_name    varchar(100) [not null, unique]
  supplier_contact varchar(20)  [not null]
}

Table products {
  product_id     serial        [pk]
  product_name   varchar(100)  [not null, unique]
  unit_price_egp numeric(10,2) [not null, note: 'current list price, >= 0']
  supplier_id    int           [not null]
}

Table orders {
  order_id     serial      [pk]
  order_number varchar(20) [not null, unique, note: 'e.g. ORD-1001']
  customer_id  int         [not null]
}

Table order_items {
  order_id       int           [not null]
  product_id     int           [not null]
  quantity       int           [not null, note: '> 0']
  unit_price_egp numeric(10,2) [not null, note: 'price charged; line total = quantity * unit_price_egp']

  indexes {
    (order_id, product_id) [pk]
  }
}

Ref: orders.customer_id      > customers.customer_id
Ref: products.supplier_id    > suppliers.supplier_id
Ref: order_items.order_id    > orders.order_id
Ref: order_items.product_id  > products.product_id
